# ── CodeArena local development environment ───────────────────────────────
# Copy to .env.local and fill in your values.
# This file is used by docker-compose.local.yml only.
# Never commit .env.local to git.

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-change-me

# GitHub OAuth — create a SEPARATE OAuth app for localhost at:
# github.com → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:5173
# Callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=codearena
POSTGRES_PASSWORD=localpassword
POSTGRES_DB=codearena
DATABASE_URL=postgresql://codearena:localpassword@codearena-db:5432/codearena

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://codearena-redis:6379

# ── Questions ─────────────────────────────────────────────────────────────
QUESTIONS_DIR=/app/questions

# ── Judge0 (optional for local coding challenge testing) ──────────────────
# Judge0 runs as a separate Docker Compose stack. See docs/deployment.md
# JUDGE0_URL=http://judge0:2358
# JUDGE0_AUTH_TOKEN=your-judge0-auth-token-here
