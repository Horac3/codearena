# ── CodeArena environment config ──────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# ── nginx-proxy / Let's Encrypt ───────────────────────────────────────────
LETSENCRYPT_EMAIL=you@example.com

# ── App URLs ──────────────────────────────────────────────────────────────
BASE_URL=https://api.codearena.never9to5ive.com
WEB_URL=https://codearena.never9to5ive.com
CORS_ORIGINS=https://codearena.never9to5ive.com,https://www.codearena.never9to5ive.com

# ── Auth ──────────────────────────────────────────────────────────────────
# At least 32 characters; production refuses to start otherwise. Generate: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=https://api.codearena.never9to5ive.com/auth/github/callback

# Comma-separated GitHub user IDs (numbers) allowed to merge contributions and verify shadow reviews
MAINTAINER_GITHUB_IDS=
# Shared secret the question-PR workflow sends as X-CI-Token to /contributions/ci/*
CI_WEBHOOK_SECRET=
# Swagger UI at /docs is off in production unless this is true
# SWAGGER_ENABLED=false

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=codearena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codearena
DATABASE_URL=postgresql://codearena:change-me@codearena-db:5432/codearena?connection_limit=7

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://codearena-redis:6379

# ── Question bank ─────────────────────────────────────────────────────────
# Path inside the container (questions/ is mounted at /app/questions)
QUESTIONS_DIR=/app/questions

# ── Judge0 (code execution engine) ────────────────────────────────────────
# Judge0 runs as a separate Docker Compose stack. See docs/deployment.md
# URL should point to the Judge0 API container (default port: 2358)
JUDGE0_URL=http://judge0:2358
# Optional: Auth token if Judge0 is configured with authentication
# JUDGE0_AUTH_TOKEN=your-judge0-auth-token-here

# ── Local dev overrides ───────────────────────────────────────────────────
# Uncomment for local development:
# DATABASE_URL=postgresql://codearena:change-me@localhost:5432/codearena
# REDIS_URL=redis://localhost:6379
# BASE_URL=http://localhost:3000
# WEB_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
