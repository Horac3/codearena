# claude-kit check commands (project-owned: edit freely; /kickoff verifies them).
# Read by .claude/kit/check.sh. Each value runs with bash -c; in CHECK_TEST_ONE, $1 is the pattern.
# Leave a value empty to skip that target.
# Stack: ts · package manager: npm
CHECK_TYPECHECK='npx tsc -p packages/question-schema && (cd apps/api && npx tsc --noEmit) && (cd apps/extension && npx tsc --noEmit)'
CHECK_LINT='npm run lint'
CHECK_TEST='npm run test'
CHECK_TEST_ONE='npm run test --workspaces --if-present -- -t "$1"'
# No Prettier in this repo (see AGENTS.md); ESLint covers formatting.
CHECK_FORMAT=''
# Max failure lines shown to Claude per target (full log always in .claude/kit/logs/).
CHECK_MAX_LINES=60
